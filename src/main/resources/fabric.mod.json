{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "icon": "assets/litematica-printer/icon.png",
  "name": "${mod_name}",
  "description": "An extension for Litematica that adds the missing printer functionality with modular architecture. Supports printing, mining, filling, fluid removal, and bedrock breaking as independent modules that can be enabled on demand.",
  "authors": [
    "aleksilassila",
    "zhaixianyu",
    "BlinkWhite",
    "bunnyi116"
  ],
  "contact": {
    "website": "${mod_homepage}",
    "homepage": "${mod_sources}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.aleksilassila.litematica.printer.LitematicaPrinterMod"
    ],
    "modmenu": [
      "me.aleksilassila.litematica.printer.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    "litematica-printer.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_dependency}",
    "malilib": ">=${malilib}",
    "litematica": ">=${litematica}",
    "fabric-content-registries-v0": "*"
  },
  "suggests": {
    "remote-inventory-next": ">=1.0.0"
  },
  "custom": {
    "modmenu": {
      "parent": "${mod_wrapper_id}"
    }
  }
}